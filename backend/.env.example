# --- Database (required) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/matchlog

# --- Session (required) ---
# Any long random string. Generate one with: openssl rand -hex 32
SESSION_SECRET=

# --- App (defaults shown — override if needed) ---
APP_URL=http://localhost:5173
PORT=4000
NODE_ENV=development

# --- Football data: OpenFootball (default, no key required) ---
# Premier League, La Liga, Serie A, Bundesliga, Ligue 1 all come from
# OpenFootball (github.com/openfootball/football.json), which needs no
# token at all. Nothing to configure here.

# --- Football data: football-data.org (required only for Champions League) ---
# Get a free token at https://www.football-data.org/client/register
# Leave this blank and everything else in the app still works — only the
# Champions League sync will report a clear "not configured" error instead
# of importing fixtures. Free tier: 10 requests/minute, data is delayed
# (not real-time). See README "Football data sources" for details.
FOOTBALL_DATA_API_TOKEN=
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4

# --- Optional/legacy: API-Football ---
# Not used by default. Only relevant if you switch the sync back to
# api-football-provider.ts (e.g. on a paid plan). See README.
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# --- Phase 3: match status/result sync cadence (all optional, defaults shown) ---
# How often (in minutes) a match still in progress gets re-checked once
# its live window has passed but it isn't marked FINISHED yet, or how often
# a not-yet-kicked-off match gets re-checked for postponements/reschedules.
MATCH_SYNC_UPCOMING_INTERVAL_MINUTES=360
# How often a match inside its live window gets re-checked.
MATCH_SYNC_LIVE_INTERVAL_MINUTES=10
# How often a just-finished match gets re-checked (catches late corrections).
MATCH_SYNC_RECENTLY_FINISHED_INTERVAL_MINUTES=15
# How many hours after kickoff a FINISHED match keeps getting re-polled at all.
MATCH_SYNC_RECENTLY_FINISHED_WINDOW_HOURS=6
# How many hours after kickoff a match is still considered "in its live window".
MATCH_SYNC_LIVE_WINDOW_HOURS_AFTER_KICKOFF=3.5
