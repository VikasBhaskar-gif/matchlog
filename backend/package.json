{
  "name": "matchlog-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.js",
    "start": "node dist/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "sync": "tsx src/sync/run.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/static": "^10.1.8",
    "@types/node": "^22.8.6",
    "@types/node-cron": "^3.0.11",
    "argon2": "^0.41.1",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.1.0",
    "fastify-plugin": "^6.0.0",
    "nanoid": "^5.0.7",
    "node-cron": "^4.6.0",
    "postgres": "^3.4.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "drizzle-kit": "^1.0.0-rc.4",
    "vite": "^7.3.6",
    "vitest": "^5.0.2"
  }
}
