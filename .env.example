# Copy this file to .env and fill in real values. Never commit .env.

# Postgres connection string used by the backend and Drizzle
DATABASE_URL=postgres://postgres:postgres@localhost:5432/matchlog

# API-Football (https://www.api-football.com/) — server-side only, never sent to the frontend
API_FOOTBALL_KEY=<YOUR_API_FOOTBALL_KEY>
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# Random long secret used to sign session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=<GENERATE_A_LONG_RANDOM_SECRET>

# Public URL of the app (used for cookie domain / CORS)
APP_URL=http://localhost:5173

# Backend server
PORT=4000
NODE_ENV=development
